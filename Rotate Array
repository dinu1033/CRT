class Solution:
    def rotate(self, nums: list[int], k: int) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        freq=[]
        n=len(nums)
        k%=n
        for i in range(n-k,n):
            freq.append(nums[i])
        for i in range(0,n-k):
            freq.append(nums[i])
        nums[:]=freq 
