class Solution:
    def reverse(self, x: int) -> int:
        r=0
        if(x>0):
            n=x
        else:
            n=-x
        while(n>0):
            d=n%10
            r=(r*10)+d
            n//=10
        if(x<0):
            r=-r
        if(r<-(2**31)or r>(2**31)-1):
            return 0
        return r                
